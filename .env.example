# PostgreSQL (Neon или локальный docker compose: postgresql://ubt:ubt@localhost:5433/ubt)
DATABASE_URL="postgresql://ubt:ubt@localhost:5433/ubt"
# Для Neon: прямое подключение без pooler (для миграций). Можно оставить равным DATABASE_URL.
DIRECT_URL="postgresql://ubt:ubt@localhost:5433/ubt"

# Секрет подписи JWT (минимум 32 случайных символа): openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Публичный адрес сайта (для QR-кода сертификата)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Пароль администратора для npm run seed
# Общий пароль демо-аккаунтов (teacher, student1..5, parent). Пусто — случайные, печатаются в консоль.
SEED_DEMO_PASSWORD=""
SEED_ADMIN_PASSWORD="change-me"

# ИИ: cerebras | openai
AI_PROVIDER="cerebras"
CEREBRAS_API_KEY=""
CEREBRAS_BASE_URL="https://api.cerebras.ai/v1"
CEREBRAS_MODEL="gpt-oss-120b"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-6.1-terra"
# Таймаут запроса к модели, мс
AI_TIMEOUT_MS="30000"
# Лимит запросов к ментору на пользователя в час
MENTOR_RATE_LIMIT_PER_HOUR="30"
